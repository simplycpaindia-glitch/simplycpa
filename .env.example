# PostgreSQL connection string (Neon, Supabase, or any Postgres host)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"

# Your site's public URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — controls the admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="choose-a-real-password"

# ── Community sign-in (see docs/COMMUNITY-SETUP.md) ──
# Google sign-in. The button only appears when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email sign-in codes via Resend. Without these, codes are printed to the server log
# in development and email sign-in is unavailable in production.
RESEND_API_KEY=""
EMAIL_FROM="SimplyCPA <signin@mail.simplycpa.in>"

# Optional Cloudflare Turnstile bot check on the email-code form (free).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Study wall moderation (optional) ──
# AI review of each post. Without a key, posts get the automatic word checks only.
ANTHROPIC_API_KEY=""
# Model used for the AI review. Default: claude-haiku-5-5. claude-opus-5-5 is more capable, ~40x the cost.
MODERATION_MODEL=""
# Comma-separated addresses for "post held for review" emails (sent via Resend).
# Default: every ADMIN or MODERATOR account — set this if those addresses can't receive mail.
MODERATOR_ALERT_EMAILS=""
